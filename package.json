{
  "name": "tabnest",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Tab manager for Chrome: park tabs into lists, folders and groups, with pluggable encrypted sync.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "icons": "node scripts/gen-icons.mjs",
    "manifest": "node scripts/manifest.mjs",
    "zip": "node scripts/zip.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "e2e": "playwright test",
    "e2e:sync": "node scripts/e2e-sync.mjs",
    "a11y": "node scripts/a11y.mjs",
    "shots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.6",
    "@playwright/test": "^1.65.0",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "fake-indexeddb": "^6.2.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
